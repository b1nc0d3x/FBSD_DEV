/*
 * ldscript.kmod.arm64
 *
 * FreeBSD's arm64 standalone KMOD link path emits the metadata sections
 * (`set_modmetadata_set`, `set_sysctl_set`, `set_sysinit_set`) but does not
 * define the usual __start/__stop linker-set symbols for them.  The kernel's
 * module loader relies on those bounds to find module metadata and process
 * sysctl/sysinit records, so self-built arm64 modules can load into memory
 * without actually registering a module entry or exposing their sysctls.
 *
 * This linker script mirrors the amd64 kmod text/rodata coalescing and adds
 * explicit linker-set bounds for the metadata sections needed by arm64 KLDs.
 */

SECTIONS
{
	.plt		:
	{
		*(.plt)
	}

	.text		:
	{
		*(.text .text.*)
		. = ALIGN(CONSTANT(COMMONPAGESIZE));
	}

	.rodata		:
	{
		*(.rodata .rodata.*)
		. = ALIGN(CONSTANT(COMMONPAGESIZE));
	}

	set_sysctl_set	:
	{
		__start_set_sysctl_set = .;
		KEEP(*(set_sysctl_set))
		__stop_set_sysctl_set = .;
	}

	set_modmetadata_set :
	{
		__start_set_modmetadata_set = .;
		KEEP(*(set_modmetadata_set))
		__stop_set_modmetadata_set = .;
	}

	set_sysinit_set :
	{
		__start_set_sysinit_set = .;
		KEEP(*(set_sysinit_set))
		__stop_set_sysinit_set = .;
	}
}
