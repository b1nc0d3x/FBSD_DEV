#
# RP64KERN_RKDRM -- Experimental RockPro64/RK3399 DRM kernel configuration.
#
# This is an integration kernel for the in-tree rk_drm scaffold. It is not
# meant to replace the working rkfb baseline yet.
#

cpu		ARM64
ident		RP64KERN_FUSB302KO

include		"std.arm64"
include		"std.dev"
include		"std.rockchip"

#
# Debugger support (serial DDB).
# Note: entering DDB on panic is controlled by loader tunables/sysctls
# (e.g. debug.kdb.panic / debug.debugger_on_panic), not just these options.
#
options		KDB
options		KDB_TRACE
options		DDB
options		BREAK_TO_DEBUGGER
options		ALT_BREAK_TO_DEBUGGER

# rk3399_power must be compiled in: rk_cdn_dp resolves rk3399_power_enable_domain
# as a direct kernel symbol (not through module dependency chain).
# drm2/rk_drm/fbd are NOT compiled in: the Linux KPI SYSINIT chain hangs boot
# on arm64 because linux_compat_init runs before the scheduler is live.
# fusb302 is NOT compiled in: crashes on boot when compiled into the kernel;
# load as a module post-boot instead (kld_list in rc.conf).
device		rk3399_power
