#
# RP64KERN_RKDRM -- Experimental RockPro64/RK3399 DRM kernel configuration.
#
# This is an integration kernel for the in-tree rk_drm scaffold. It is not
# meant to replace the working rkfb baseline yet.
#

cpu		ARM64
ident		RP64KERN_FUSB302KO

include		"std.arm64"
include		"std.dev"
include		"std.rockchip"

#
# Debugger support (serial DDB).
# Note: entering DDB on panic is controlled by loader tunables/sysctls
# (e.g. debug.kdb.panic / debug.debugger_on_panic), not just these options.
#
options		KDB
options		KDB_TRACE
options		DDB
options		BREAK_TO_DEBUGGER
options		ALT_BREAK_TO_DEBUGGER

# rk3399_power must be compiled in: rk_cdn_dp resolves rk3399_power_enable_domain
# as a direct kernel symbol (not through module dependency chain).
# fusb302 + rk_cdn_dp are now compiled in (was modules) so they attach during
# normal device probe rather than at userland kld_list time — moves panel
# bring-up earlier in boot by several seconds.  Revert to module form if a
# probe-time hang reappears (kld_list slot in /etc/rc.conf still works fine).
device		rk3399_power
device		fbd
device		drm2
device		rk_drm
device		fusb302
device		rk_cdn_dp

# HDMI audio path (Stage 3): pcm framework + DAI binder + I2S2 + a
# placeholder codec.  audio_soc binds the CPU-side DAI (rk_i2s on
# i2s2 @ 0xff8a0000) to a dummy-codec on the boot DT's
# simple-audio-card node, exposing /dev/dsp0 to userland.  Without
# the simple-audio-card DT node this is harmless -- the framework
# just doesn't bind anything.
device		sound
options		SOC_ROCKCHIP_RK3399
